{
  "manifest_version": 3,
  "name": "Vaultly",
  "version": "1.0.0",
  "description": "Fill logins from your team's Vaultly. Your master password and keys never leave the browser.",
  "action": { "default_popup": "popup.html", "default_title": "Vaultly", "default_icon": "icon128.png" },
  "icons": { "128": "icon128.png" },
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "idle"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
